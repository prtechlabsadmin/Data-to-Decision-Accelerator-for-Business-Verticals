# ============================================================
# Data-to-Decision Accelerator — Environment Variables
# Copy to .env and adjust:    cp .env.example .env
# NEVER commit the real .env file (it is git-ignored).
#
# Precedence: .env values OVERRIDE config.yaml defaults.
# ============================================================

# Base directory for data artifacts.
# On Streamlit Cloud, set this to a writable dir via Settings -> Secrets.
DATA_DIR=data

# Random seed controlling the synthetic dataset.
# Keep 42 so every clone reproduces identical results.
SEED=42

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Location of the central config file (rarely needs changing)
CONFIG_PATH=config.yaml
